{
    // ===== 编码：Keil C51 原生用 GBK，中文注释不会乱码 =====
    "files.encoding": "gbk",
    "files.autoGuessEncoding": true,

    // ===== 缩进：跟 Keil 保持一致（Tab 缩进）=====
    "editor.tabSize": 4,
    "editor.insertSpaces": false,
    "editor.detectIndentation": false,

    // ===== IntelliSense 默认搜索路径（51 头文件）=====
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/**",
        "G:/Keil5/C51/INC",
        "G:/Keil5/C51/INC/Atmel"
    ],
    "C_Cpp.default.cStandard": "c89",
    "C_Cpp.default.intelliSenseMode": "windows-gcc-x86",
    "C_Cpp.errorSquiggles": "enabled",

    // ===== 文件关联 =====
    "files.associations": {
        "*.h": "c",
        "*.uvproj": "xml",
        "*.uvprojx": "xml",
        "*.uvopt": "xml"
    },

    // ===== 隐藏 Keil 的中间产物，资源管理器更清爽 =====
    "files.exclude": {
        "**/Objects": true,
        "**/Listings": true,
        "**/*.uvgui.*": true,
        "**/*.uvopt": true,
        "**/*.uvoptx": true,
        "**/*.M51": true,
        "**/*.lst": true,
        "**/*.build_log.htm": true,
        "**/*.plg": true
    },
    "search.exclude": {
        "**/Objects": true,
        "**/Listings": true
    },

    // ===== 编辑器体验 =====
    "editor.rulers": [80],
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.indentation": true,
    "editor.suggest.showSnippets": true,
    "editor.quickSuggestions": {
        "other": true,
        "comments": false,
        "strings": false
    },
    "files.trimTrailingWhitespace": false,

    // ===== 关闭 cpplint 的代码风格检查 =====
    // cpplint 会强制要求：文件开头写 Google 版权声明、"Tab found; better to use spaces"、
    // 文件末尾必须有空行。这三条规则对 51 单片机开发毫无意义（Keil 本来就用 Tab 缩进），
    // 纯属噪音。关掉后不影响编译，也不影响 cppcheck 的静态分析。
    "cpp-check-lint.cpplint.--enable": false
}
 125          /* 每 100ms：比较两轮实际转速，哪边相对慢就把补偿往哪边调 */
 126          static void sync_step(void)
 127          {
 128   1          unsigned int l = enc_take(&enc_l);
 129   1          unsigned int r = enc_take(&enc_r);
